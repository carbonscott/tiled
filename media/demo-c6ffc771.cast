[71.749168, "o", "\u001b[1;33m━━ Step 4/4: 60-cell matrix through a live `tiled serve` per build: base, pr2, head\u001b[0m\r\n"]
[71.74935, "o", "\u001b[2m3 layouts x 2 registrations (whole, row) x 5 requests x 2 dtypes = 60 cells per build\u001b[0m\r\n"]
[71.749478, "o", "\u001b[1;32m$\u001b[0m \u001b[32mO=$M/matrix-c6ffc771.out\u001b[0m\r\n"]
[71.749706, "o", "\u001b[1;32m$\u001b[0m \u001b[32muv run --script $P/tiled_e2e.py matrix --workdir $W --build base --build pr2 --build head \\\r\n"]
[71.749789, "o", "    --require-pass head 2>&1 | tee $O \\\r\n"]
[71.751082, "o", "    | grep --line-buffered -E '^=== build|\\] ready at|^registered' | stamp; st=${PIPESTATUS[0]}\u001b[0m\r\n"]
