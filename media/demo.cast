[70.76423, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;33m━━ Step 4/4: 60-cell matrix through a live `tiled serve` per build: base, pr2, head\u001b[0m\r\n\u001b[2m3 layouts x 2 registrations (whole, row) x 5 requests x 2 dtypes = 60 cells per build\u001b[0m\r\n\u001b[1;32m$\u001b[0m \u001b[32muv run --script $P/tiled_e2e.py matrix --workdir $W --build base --build pr2 --build head \\\r\n    --require-pass head 2>&1 | tee $M/matrix.out \\\r\n    | grep --line-buffered -E '^=== build|\\] ready at|^registered' | stamp; st=${PIPESTATUS[0]}\u001b[0m\r\n"]
